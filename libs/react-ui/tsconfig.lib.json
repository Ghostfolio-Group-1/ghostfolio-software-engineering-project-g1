{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "integration/**/*.ts",
    "integration/**/*.tsx",
    "jest.config.ts",
    "jest.integration.config.ts"
  ]
}
