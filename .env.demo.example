# Demo environment for docker/docker-compose.demo.yml.
# Copy to .env.demo (git-ignored) and replace every CHANGE_ME value.
# Never commit .env.demo.
COMPOSE_PROJECT_NAME=ghostfolio_demo

# CACHE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# POSTGRES
POSTGRES_DB=ghostfolio-demo
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# API
ACCESS_TOKEN_SALT=CHANGE_ME_access_token_salt
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connect_timeout=300
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key
